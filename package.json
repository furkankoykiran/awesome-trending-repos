{
  "name": "awesome-trending-repos",
  "version": "1.0.0",
  "description": "A daily-updated, auto-curated list of the most awesome trending open-source repositories. Enriched with deep insights and historical data, powered by GitHub Actions.",
  "type": "module",
  "main": "scripts/update.js",
  "homepage": "https://furkankoykiran.com.tr/awesome-trending-repos/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furkankoykiran/awesome-trending-repos.git"
  },
  "bugs": {
    "url": "https://github.com/furkankoykiran/awesome-trending-repos/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.js && node scripts/verify-build.js",
    "preview": "vite preview --base /awesome-trending-repos/",
    "update": "node scripts/update.js",
    "verify": "node scripts/verify-build.js",
    "test": "node --test tests/data.test.js tests/site.test.js"
  },
  "keywords": [
    "awesome-list",
    "github-trending",
    "open-source",
    "automation",
    "github-actions",
    "react",
    "vite",
    "dashboard",
    "prerender"
  ],
  "author": "Furkan Köykıran",
  "license": "MIT",
  "dependencies": {
    "@octokit/plugin-throttling": "^11.0.3",
    "axios": "^1.8.4",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.10",
    "lucide-react": "^0.479.0",
    "octokit": "^4.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.12",
    "vite": "^6.2.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
